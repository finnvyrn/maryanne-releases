# Maintainer: Sentria <support@maryanne.app>
pkgname=maryanne-bin
pkgver=2.0.0
pkgrel=1
pkgdesc='Closed-source Flutter ebook reader with local text-to-speech'
arch=('x86_64')
url='https://maryanne.app'
license=('custom')
depends=('gtk3' 'gstreamer' 'gst-plugins-base' 'libsecret')
release_repo='finnvyrn/maryanne-releases'
source=("https://github.com/${release_repo}/releases/download/v${pkgver}/Maryanne-x86_64.AppImage")
sha256sums=('SKIP')

package() {
  install -Dm755 "Maryanne-x86_64.AppImage" \
    "${pkgdir}/opt/maryanne/Maryanne-x86_64.AppImage"

  install -d "${pkgdir}/usr/bin"
  ln -s /opt/maryanne/Maryanne-x86_64.AppImage \
    "${pkgdir}/usr/bin/maryanne"
}
